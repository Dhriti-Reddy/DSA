class Solution {
    public String removeOuterParentheses(String s) {
        StringBuilder result = new StringBuilder();
        int count = 0;
        char[] chars = s.toCharArray();
        for(int i=0; i<chars.length; i++){
            if(count == 0 && chars[i] == '('){
                count++;
                continue;
            }

            if(count == 1 && chars[i] == ')'){
                count--;
                continue;
            }

            if(chars[i] == '(' && count != 0){
                result.append(chars[i]);
                count++;
            }
            
            if(chars[i] == ')' && count != 1){
                result.append(chars[i]);
                count--;
            }
        }
        return result.toString();
    }
}