class Solution {
    public int sumSubarrayMins(int[] arr) {
        int n = arr.length;
        int[] left = new int[n];
        int[] right = new int[n];
        Stack<Integer> s = new Stack<>();
        for(int i = 0; i < n; i++){
            while(!s.isEmpty() && arr[s.peek()] > arr[i]){
                s.pop();
            }
            if(s.isEmpty()) left[i] = i + 1;
            else left[i] = i - s.peek();
            s.push(i);
        }
        s.clear();
        for(int i = n - 1; i >= 0; i--){
            while(!s.isEmpty() && arr[s.peek()] >= arr[i]){
                s.pop();
            }
            if(s.isEmpty()) right[i] = n - i;
            else right[i] = s.peek() - i;
            s.push(i);
        }
        long ans = 0;
        for(int i = 0; i < n; i++){
            ans = (ans + (long) arr[i] * left[i] * right[i]) % 1000000007;
        }
        return (int) ans;
    }
}