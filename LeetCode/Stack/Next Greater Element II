class Solution {
    public int[] nextGreaterElements(int[] nums) {
        int[] ans = new int[nums.length];
        Arrays.fill(ans, -1); 
        Stack<Integer> s = new Stack<>();
        for (int i = 0; i < 2 * nums.length; i++) {
            while (!s.isEmpty() && nums[s.peek()] < nums[i % nums.length]) {
                int index = s.pop();
                ans[index] = nums[i % nums.length];
            }
            if (i < nums.length) {
                s.push(i);
            }
        }
        return ans;
    }
}