class Solution {
    public int snakesAndLadders(int[][] board) {
        Queue<Integer> q = new LinkedList<>();
        q.add(1);
        int n = board.length;
        boolean[] visited = new boolean[n*n];
        visited[0] = true;
        int rolls = 0;

        while(!q.isEmpty()){
            int size = q.size();
            for(int i=0; i<size; i++){
                int current = q.poll();
                for(int dice=1; dice<=6; dice++){
                    int next = current + dice;
                    if(next > n*n) continue;
                    int row = (n - 1) - (next - 1) / n;
                    int col = (next - 1) % n;
                    if((n - 1 - row) % 2 == 1){
                        col = n - 1 - col;
                    }
                    if (board[row][col] != -1){
                        next = board[row][col];
                    }
                    if(next == n*n){
                        return rolls + 1;
                    }
                    if(!visited[next]){
                        visited[next] = true;
                        q.add(next);
                    }
                }
            }
            rolls++;
        }
        return -1;
    }
}