class Solution {
    public String longestPalindrome(String s) {
        int n = s.length();
        boolean[][] dp = new boolean[n][n];
        int start = 0;
        int maxlength = 0;
        for(int i=n-1; i>=0; i--){
            for(int j=i; j<n; j++){
                if(i == j){
                    dp[i][j] = true;
                }
                else if(j == i+1 &&s.charAt(i) == s.charAt(j)) {
                    dp[i][j] = true;
                }
                else{
                    dp[i][j] = s.charAt(i) == s.charAt(j) && dp[i + 1][j - 1];
                }

                if (dp[i][j]) {
                    int length = j - i + 1;
                    if (length > maxlength) {
                        maxlength = length;
                        start = i;
                    }
                }
            }
        }
        return s.substring(start, start + maxlength);
    }
}