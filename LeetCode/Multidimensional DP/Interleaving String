class Solution {
    public boolean isInterleave(String s1, String s2, String s3) {
        int rows = s1.length();
        int cols = s2.length();
        boolean[][] dp = new boolean[rows+1][cols+1];
        //dp is can I form the first i + j characters of s3 by using the first i characters of s1 and the first j characters of s2
        dp[0][0] = true;
        if(rows + cols != s3.length()) return false;

        for(int i=0; i<=rows; i++){
            for(int j=0; j<=cols; j++){
                if(i>0 && s1.charAt(i-1) == s3.charAt(i+j-1)){
                    dp[i][j] = dp[i][j] || dp[i-1][j];
                }
                if(j>0 && s2.charAt(j-1) == s3.charAt(i+j-1)){
                    dp[i][j] = dp[i][j] || dp[i][j-1];
                }//two ifs bcoz that particular letter can be in both strings
            }
        }
        return dp[rows][cols];
    }
}