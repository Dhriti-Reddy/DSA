/**
 * Definition for singly-linked list.
 * class ListNode {
 *     int val;
 *     ListNode next;
 *     ListNode(int x) {
 *         val = x;
 *         next = null;
 *     }
 * }
 */

public class Solution {
    public ListNode detectCycle(ListNode head) {
        if (head == null) {
            return null;
        }

        ListNode right = head;
        ListNode left = head;

        while (right != null && right.next != null) {
            left = left.next;
            right = right.next.next;

            if (left == right) {
                left = head;

                while (left != right) {
                    left = left.next;
                    right = right.next;
                }

                return left;
            }
        }

        return null;
    }
}