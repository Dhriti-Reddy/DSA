class Solution {
    public List<List<String>> solveNQueens(int n) {
        List<List<String>> ans = new ArrayList<>();
        char[][] board = new char[n][n];
        for(int i = 0; i < n; i++){
            Arrays.fill(board[i], '.');
        }
        boolean[] col = new boolean[n];
        boolean[] diag1 = new boolean[2 * n - 1];
        boolean[] diag2 = new boolean[2 * n - 1];
        backtrack(0, n, col, diag1, diag2, board, ans);
        return ans;
    }

    void backtrack(int row, int n, boolean[] col, boolean[] diag1, boolean[] diag2, char[][] board, List<List<String>> ans){
        if(row == n){
            List<String> solution = new ArrayList<>();
            for(int i = 0; i < n; i++){
                solution.add(new String(board[i]));
            }
            ans.add(solution);
            return;
        }
        for(int j=0; j<n; j++){
            if(!col[j] && !diag1[row - j + n - 1] && !diag2[row + j]){
                col[j] = true;
                diag1[row - j + n - 1] = true;
                diag2[row + j] = true;
                board[row][j] = 'Q';
                backtrack(row+1, n, col, diag1, diag2, board, ans);
                col[j] = false;
                diag1[row - j + n - 1] = false;
                diag2[row + j] = false;
                board[row][j] = '.';
            }
        }
    }
}