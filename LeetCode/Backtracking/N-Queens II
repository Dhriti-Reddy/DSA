class Solution {
    public int totalNQueens(int n) {
        boolean[] col = new boolean[n];
        boolean[] diag1 = new boolean[2 * n - 1];
        boolean[] diag2 = new boolean[2 * n - 1];
        return backtrack(0, n, col, diag1, diag2);
    }

    int backtrack(int row, int n, boolean[] col, boolean[] diag1, boolean[] diag2){
        if(row == n){
            return 1;
        }
        int count = 0;
        for(int j=0; j<n; j++){
            if(!col[j] && !diag1[row - j + n - 1] && !diag2[row + j]){
                col[j] = true;
                diag1[row - j + n - 1] = true;
                diag2[row + j] = true;
                count += backtrack(row+1, n, col, diag1, diag2);
                col[j] = false;
                diag1[row - j + n - 1] = false;
                diag2[row + j] = false;
            }
        }//backtrack alr tells the row so loop only for col
        return count;
    }
}